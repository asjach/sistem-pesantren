{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "app-tab-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-size",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "/Volumes/**", "D:/**", "E:/**"]
    }
  ]
}
