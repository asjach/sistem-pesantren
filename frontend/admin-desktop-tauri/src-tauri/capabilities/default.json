{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "app-tab-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-save"
  ]
}
